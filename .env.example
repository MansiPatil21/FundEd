# Used by `docker compose --profile full`. Copy to .env and replace both secrets.
# There are no defaults on purpose: a signing secret that falls back to a known string ships.
JWT_SECRET="replace-with-at-least-24-random-characters"
FX_WEBHOOK_SECRET="replace-with-at-least-16-characters"
FX_POLL_ENABLED="true"
FX_PAIRS="CAD:INR"
# Lets the production images accept email-only sign-in, for trying the stack locally.
# Never enable this on anything reachable from the internet.
ALLOW_LOCAL_SIGN_IN="false"
# Host port for Nginx. Change it if 8080 is already in use.
FUNDED_HTTP_PORT="8080"
