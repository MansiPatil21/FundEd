# Mongo runs as a single-node replica set because Prisma requires one for
# transactions. docker-compose initiates it on first boot.
DATABASE_URL="mongodb://localhost:27017/funded?replicaSet=rs0&directConnection=true"
REDIS_URL="redis://localhost:6380"
PORT=4000
LOG_LEVEL=info
# No defaults for these two: a signing secret that falls back to a known string is
# worse than one that is missing, because the missing one fails loudly at boot.
JWT_SECRET="at-least-24-characters-long"
FX_WEBHOOK_SECRET="shared-with-the-rate-provider"
CORS_ORIGIN="http://localhost:3000"
# Scheduled exchange-rate polling (BullMQ). Off by default so a bare checkout makes no
# outbound calls. The source is keyless daily ECB reference rates, so polling every few
# hours is plenty; repeats of one publication are stored once.
FX_POLL_ENABLED="false"
FX_PAIRS="CAD:INR"
FX_POLL_EVERY_MINUTES=360
FX_SOURCE_URL="https://api.frankfurter.dev/v1"
