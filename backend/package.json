    "@types/jsonwebtoken": "^9.0.10",
    "bullmq": "^6.3.4",
    "cors": "^2.8.6",
    "express": "^5.0.1",
    "graphql": "^16.14.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^6.3.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
